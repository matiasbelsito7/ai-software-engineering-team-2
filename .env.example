# =============================================================================
# AI Software Engineering Team - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings.
# Use __ (double underscore) as separator for nested settings.
# =============================================================================

# =============================================================================
# App
# =============================================================================

APP__ENVIRONMENT=development
APP__DEBUG=false
APP__HOST=0.0.0.0
APP__PORT=8000
APP__RELOAD=true
APP__WORKERS=1
APP__API_PREFIX=/api/v1

# =============================================================================
# LLM Provider
# =============================================================================

# Options: openrouter or ollama
LLM__PROVIDER=ollama

# OpenRouter (uncomment if using openrouter)
# LLM__OPENROUTER__API_KEY=sk-or-your-key-here
# LLM__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1

# Ollama (uncomment if using ollama)
LLM__OLLAMA__BASE_URL=http://localhost:11434
# LLM__OLLAMA__DEFAULT_MODEL=llama3.1

# Generation parameters
# LLM__DEFAULT_MODEL=llama3.1
# LLM__TEMPERATURE=0.7
# LLM__MAX_TOKENS=4096
# LLM__TOP_P=1.0
# LLM__STREAMING=true
# LLM__TRACK_COSTS=true

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# DATABASE__HOST=localhost
# DATABASE__PORT=5432
# DATABASE__NAME=ai_team
# DATABASE__USERNAME=postgres
# DATABASE__PASSWORD=postgres
# DATABASE__POOL_SIZE=5
# DATABASE__MAX_OVERFLOW=10

# =============================================================================
# Redis
# =============================================================================

REDIS__HOST=localhost
REDIS__PORT=6379
# REDIS__PASSWORD=
# REDIS__DB=0
# REDIS__POOL_SIZE=10
# REDIS__CACHE_TTL=3600
# REDIS__KEY_PREFIX=ai_team:

# =============================================================================
# Qdrant (Vector Database)
# =============================================================================

QDRANT__HOST=localhost
QDRANT__PORT=6333
# QDRANT__GRPC_PORT=6334
# QDRANT__COLLECTION=ai_team
# QDRANT__VECTOR_SIZE=1536
# QDRANT__DISTANCE=Cosine

# =============================================================================
# Docker
# =============================================================================

# DOCKER__HOST=unix:///var/run/docker.sock
# DOCKER__TLS=false
# DOCKER__TIMEOUT=60
# DOCKER__PRIVILEGED=false

# =============================================================================
# HTTP Client
# =============================================================================

# HTTP__CONNECT_TIMEOUT=10
# HTTP__READ_TIMEOUT=30
# HTTP__WRITE_TIMEOUT=10
# HTTP__POOL_TIMEOUT=10

# =============================================================================
# Security
# =============================================================================

# API Key Authentication (disabled by default)
# SECURITY__AUTH_ENABLED=true
# SECURITY__API_KEYS=["your-api-key-1","your-api-key-2"]
# SECURITY__AUTH_HEADER=X-API-Key

# Rate Limiting (enabled by default)
SECURITY__RATE_LIMIT_ENABLED=true
SECURITY__RATE_LIMIT_PER_IP=100
SECURITY__RATE_LIMIT_PER_KEY=200
SECURITY__RATE_LIMIT_BURST=20

# Security Headers (enabled by default)
SECURITY__SECURITY_HEADERS_ENABLED=true
# SECURITY__HSTS_MAX_AGE=31536000
# SECURITY__CONTENT_SECURITY_POLICY=default-src 'none'

# Request Limits
# SECURITY__MAX_REQUEST_BODY_SIZE=10485760

# Audit Logging (enabled by default)
SECURITY__AUDIT_LOG_ENABLED=true
# SECURITY__AUDIT_LOG_AUTH_ATTEMPTS=true
# SECURITY__AUDIT_LOG_RATE_LIMITS=true

# =============================================================================
# Telemetry
# =============================================================================

# TELEMETRY__LOGGING_ENABLED=true
# TELEMETRY__LOG_LEVEL=INFO
# TELEMETRY__TRACING_ENABLED=false
# TELEMETRY__TRACING_ENDPOINT=http://localhost:4318
# TELEMETRY__METRICS_ENABLED=false
# TELEMETRY__METRICS_PORT=9090
